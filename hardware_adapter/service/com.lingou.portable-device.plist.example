<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lingou.portable-device</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source "$HOME/.config/lingou/device.env"; exec /opt/lingou/.venv-portable/bin/python -B -m hardware_adapter.portable_voice_client --no-keyboard-control</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/lingou</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/tmp/lingou-portable-device.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/lingou-portable-device.err</string>
</dict>
</plist>
