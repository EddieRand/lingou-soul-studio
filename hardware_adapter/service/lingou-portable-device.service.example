[Unit]
Description=Lingou portable independent voice carrier
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=lingou
Group=audio
WorkingDirectory=/opt/lingou
EnvironmentFile=/etc/lingou/device.env
ExecStart=/opt/lingou/.venv-portable/bin/python -B -m hardware_adapter.portable_voice_client --no-keyboard-control
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
