# Lingou Companion Server Environment Variables
# Copy this file to .env and fill in your values

# Doubao Ark API (online brain)
ARK_API_KEY=your_api_key_here
ARK_ENDPOINT_ID=your_endpoint_id_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Doubao Ark Bot (联网搜索应用，可选)
ARK_BOT_ID=your_bot_id_here

# Volcengine TTS (火山情感音色)
VOLC_TTS_API_KEY=your_volc_tts_api_key_here
VOLC_TTS_RESOURCE_ID=volc.service_type.10029
VOLC_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLC_TTS_DEFAULT_SPEAKER=zh_male_beijingxiaoye_emo_v2_mars_bigtts

# Volcengine ASR (火山大模型流式语音识别 sauc bigmodel)
# API Key 复用 VOLC_TTS_API_KEY，或单独配置 VOLC_ASR_API_KEY
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Authentication (required, keep private; generate at least 32 random bytes)
LINGOU_JWT_SECRET=
# Comma-separated development origins. Same-origin production requests do not need CORS.
LINGOU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Provider warmup is opt-in so a server start cannot trigger a model call unexpectedly.
LINGOU_WARMUP_ON_STARTUP=0
# Development-only test-base and short-lived credential endpoints. Production
# bases use offline provisioning and do not require this switch.
LINGOU_ENABLE_TEST_DEVICE_AUTH=0
# Deferred simulators, relationship fast-forward, brain overrides and voice
# cloning. Keep disabled for the normal MVP user path.
LINGOU_ENABLE_DEV_TOOLS=0
# Deferred relationship/streak/neglect/touch-escalation runtime rules.
LINGOU_ENABLE_DEFERRED_GAMEPLAY=0
